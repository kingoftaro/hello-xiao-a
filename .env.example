# Development configuration. Copy to .env and replace change-me values.
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# OpenAI-compatible LLM
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_LLM_MODEL=deepseek-chat
LITE_LLM_MODEL=deepseek-chat
PRIMARY_LLM_TEMPERATURE=0.2
PRIMARY_LLM_MAX_TOKENS=2048

# Optional Ollama fallback (install Ollama separately)
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_API_KEY=EMPTY

# Embedding and reranker
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
LOCAL_MODEL_DEVICE=auto
HF_HOME=/data/hf_cache
RERANKER_PROVIDER=local_bge
RERANKER_MODEL=BAAI/bge-reranker-large
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Data services; passwords must match docker-compose.yml
VECTOR_STORE_PROVIDER=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=enterprise_knowledge
MILVUS_USER=root
MILVUS_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise_agent
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# Authentication
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-agent

# Features and external-system placeholders
RATE_LIMIT_PER_MINUTE=60
KB_FEEDBACK_AUTO_DRAFT=true
CRM_API_BASE=https://crm.example.com/api/v1
MAIL_API_BASE=https://mail.example.com/api/v1
TICKET_API_BASE=https://ticket.example.com/api/v1
