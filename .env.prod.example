# Production configuration. Copy to .env.prod and replace every change-me value.
APP_ENV=prod
LOG_LEVEL=INFO
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_LLM_MODEL=deepseek-chat
LITE_LLM_MODEL=deepseek-chat
PRIMARY_LLM_TEMPERATURE=0.2
PRIMARY_LLM_MAX_TOKENS=2048
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
LOCAL_MODEL_DEVICE=cpu
RERANKER_PROVIDER=local_bge
RERANKER_MODEL=BAAI/bge-reranker-large
VECTOR_STORE_PROVIDER=milvus
MILVUS_USER=root
MILVUS_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise_agent
REDIS_PASSWORD=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
GRAFANA_ADMIN_PASSWORD=change-me
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
RATE_LIMIT_PER_MINUTE=60
KB_FEEDBACK_AUTO_DRAFT=true
CRM_API_BASE=https://crm.example.com/api/v1
MAIL_API_BASE=https://mail.example.com/api/v1
TICKET_API_BASE=https://ticket.example.com/api/v1
